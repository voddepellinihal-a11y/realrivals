APP_ENV=development
# Render's blueprint sets ENVIRONMENT=production (production enables the
# JWT secret checks and the SPA/production defaults).
ENVIRONMENT=development
APP_NAME=RealLifeRivals

# Supabase (Postgres) — connection pooler (port 6543).
# The direct host on port 5432 is not reachable from every network (e.g. Render).
# Fill in your own project ref and password — never commit real credentials.
DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
REDIS_URL=redis://localhost:6379/0

# Signing key for access/refresh tokens.  Must be >= 32 bytes in production.
# Render generates one for you: JWT_SECRET_KEY -> generateValue: true
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# Comma separated list of allowed origins.  "*" allows every domain.
CORS_ORIGINS=*

# Email (SMTP) — configure for email verification and password reset
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Real-Life Rivals
# Public URL of the app (used for links in emails).
# On Render this is auto-populated from RENDER_EXTERNAL_URL.
FRONTEND_URL=http://localhost:8000
